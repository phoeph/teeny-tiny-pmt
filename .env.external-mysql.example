# PMT 项目环境变量配置（外部 MySQL 版本）
# 复制此文件为 .env 并填写实际值

# ============================================
# MySQL 连接配置（外部 MySQL）
# ============================================

# MySQL 主机地址
# - 如果 MySQL 在宿主机: host.docker.internal
# - 如果 MySQL 是 Docker 容器: 容器名
# - 如果 MySQL 在其他服务器: IP 地址
MYSQL_HOST=host.docker.internal

# MySQL 端口
MYSQL_PORT=3306

# 数据库名称
MYSQL_DATABASE=pmt_db

# MySQL 用户名
MYSQL_USER=root

# MySQL 密码
MYSQL_PASSWORD=your_mysql_password

# 完整的数据库连接 URL（自动生成，也可手动修改）
DATABASE_URL=mysql+aiomysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}

# ============================================
# 应用配置
# ============================================

# 应用密钥（用于加密，请使用随机字符串）
# 生成方法: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_please_change_this_to_random_string

# Excel 标签文件路径
LABELS_EXCEL_PATH=/data/labels/菜单级联关系.xlsx

# ============================================
# 前端配置
# ============================================

# 前端访问端口（如果 80 端口被占用，可以改为 8080 等）
FRONTEND_PORT=80

# ============================================
# 环境
# ============================================

ENVIRONMENT=production
