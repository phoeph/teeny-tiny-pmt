# MySQL 数据库配置
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_DATABASE=pmt
MYSQL_USER=pmt_user
MYSQL_PASSWORD=your_strong_user_password_here

# 应用配置
SECRET_KEY=your_secret_key_change_this_to_a_random_string_at_least_32_characters
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Excel 标签文件路径
# 可以使用相对路径（相对于项目根目录）或绝对路径
LABELS_EXCEL_PATH=/data/labels/菜单级联关系.xlsx

# 可选：HTTPS 配置
# SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
# SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 注意事项：
# 1. 复制此文件为 .env 并修改密码和密钥
# 2. 密码建议至少 16 位，包含大小写字母、数字和特殊字符
# 3. SECRET_KEY 可以使用以下命令生成：
#    python -c "import secrets; print(secrets.token_urlsafe(32))"
# 4. 不要将 .env 文件提交到版本控制系统
